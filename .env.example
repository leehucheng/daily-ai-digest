# === LLM Providers (設哪個打哪個；兩個都設時依 LLM_PROVIDER 自動備援) ===
# auto = 優先 Gemini，遇 429/額度用盡/未設時自動切 Claude（或反之，看 LLM_PROVIDER）
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# === SNS Sources ===
# 免費 10,000 次額度：解鎖 Instagram (+留言)、Threads、Reddit backfill
SCRAPECREATORS_API_KEY=
# 每月 $5 免費額度：安全抓 X / Twitter（不碰私人 X cookie）
APIFY_API_TOKEN=
# 小紅書選配（預設 false；啟用前需本機或指定 URL 跑 xiaohongshu-mcp）
ENABLE_XHS=false
XIAOHONGSHU_API_BASE=http://localhost:18060

# === Notifications ===
# Pixel 10 Pro ntfy 私密 topic（例如 daily-ai-hucheng-xxxx，請自訂隨機字串）
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Gmail 雙推（GitHub Actions 雲端用 Google 應用程式密碼）
GMAIL_TO=lee52025202@gmail.com
GMAIL_SENDER=lee52025202@gmail.com
GMAIL_APP_PASSWORD=

# === Site URL (推播通知點擊連結) ===
DIGEST_SITE_URL=https://leehucheng.github.io/daily-ai-digest/
